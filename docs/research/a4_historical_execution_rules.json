  "limitations": [
    "Historical day-specific ST, suspension and exchange preclose are still required from original market data. Rule verification does not certify those inputs.",
    "Commission 3bp, adverse 2bp rounded to ticks, fixed dividend tax20% are declared modelling assumptions, not universally applicable personal account tariffs.",
    "Investor eligibility for STAR is not inferred from the CNY100000 simulated capital.",
    "No queue priority, auction volume participation or order-book price-cage certification.",
    "Original issuer transfer-fee webpage unavailable; archived original screenshot provenance is disclosed."
  ],
  "original_source_bytes_saved": true,
  "preserved_algorithms": "All original A2 top-level function/class ASTs are identical except price_limits and execute_target_weights. Execution entry derives historical fees and refuses a live clock; no global monkeypatch.",
  "provenance_policy": {
    "csdc_notice": "Original issuer webpage could not be retrieved. The exact issuer announcement screenshot hosted in the contemporaneous Xinhua report was visually checked and byte-bound; CSDC own timeline and SSE own fee page are independent corroboration.",
    "historical_known_at": "Never relabel a 2026 fetch as a historical announcement. Source fetch receipts carry historical_known_at=null; source published/effective dates are separate facts.",
    "pre_registration_source_coverage": "SSE 2020 general rules + 2020 ST rule + 2019 STAR special rules; SZSE 2021 general rules. Post-2023-04-10 use 2023 rule documents."
  },
  "rule_version": "a4-raw-integer-2023-2024-historical-rules-v1",
  "rules": {
    "buy_lots": {
      "main_and_chinext": {
        "increment": 100,
        "minimum": 100
      },
      "star": {
        "increment": 1,
        "minimum": 200
      }
    },
    "fees": {
      "commission_rate_assumption": "0.0003",
      "dividend_tax_reserve_assumption": "0.20",
      "minimum_commission_cny": "5.00",
      "sell_stamp_rate_before_2023_08_28": "0.001",
      "sell_stamp_rate_on_or_after_2023_08_28": "0.0005",
      "slippage_bps_assumption": "2",
      "slippage_tick_rounding": "adverse whole cent, capped at observed daily limits",
      "transfer_rate_both_directions": "0.00001"
    },
    "first_main_registration_listing": "2023-04-10",
    "ipo_policy": {
      "chinext_and_star": "First five exchange sessions have no daily price limits; conservatively exclude execution.",
      "main_listing_before_2023_04_10": "Conservatively exclude first five exchange sessions. Legacy first-day effective order prices used issue-price 144%/64% bounds; do not pretend these sessions were unrestricted.",
      "main_listing_on_or_after_2023_04_10": "First five exchange sessions have no daily price limits; conservatively exclude execution."
    },
    "limit_order_maximum": {
      "chinext": 300000,
      "main": 1000000,
      "star": 100000
    },
    "limit_price_rounding": "ROUND_HALF_UP to CNY cents; minimum one-tick excursion, positive lower limit",
    "ordinary_price_limits": {
      "chinext": "0.20",
      "sse_main": "0.10",
      "star": "0.20",
      "szse_main": "0.10"
    },
    "price_tick_cny": "0.01",
    "research_fill_policy": "Refuse adverse upper-limit buys/lower-limit sells and unknown status; actual raw exchange preclose required. Daily bars cannot establish liquidity, price-cage order-book details or actual fills.",
    "risk_warning_price_limits": {
      "chinext": "0.20",
      "sse_main": "0.05",
      "star": "0.20",
      "szse_main": "0.05"
    },
    "sell_odd_remainders": "An odd remaining balance may only be sold together, never split; preserve original A2 lot implementation.",
    "suspension_valuation": "Source-confirmed suspension can carry a disclosed prior mark beyond the staleness cap; original valuation_complete remains false when a current observed mark is missing.",
    "t_plus_one": "Same-session purchases cannot be sold; next actual exchange session unlocks."
  },
  "schema_version": 1,
  "scope": "Ordinary SSE/SZSE main-board, ChiNext and STAR A-share historical research only. No BSE, relisting, delisting-period or IPO initial-window simulated fills.",
